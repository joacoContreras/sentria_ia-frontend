# ==============================================================================
# SENTRIA AI - Variables de Entorno del Frontend
# ==============================================================================

# URL Base del Backend en Java (Spring Boot / Jakarta REST)
# En desarrollo local suele ser http://localhost:8080
# Dejar vacío ("") para activar el modo de contingencia con Mocks locales.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Tiempo máximo de espera para peticiones HTTP en milisegundos (por defecto: 15000)
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=15000

# Bypass de autenticación para desarrollo y revisión de UI (true / false)
# En 'true' carga un usuario desarrollador simulado si no hay sesión iniciada.
NEXT_PUBLIC_DEV_AUTO_LOGIN=false
